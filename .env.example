# Copiá a .env.local (nunca subas secretos a GitHub)

# Solo en la copia de demostración: entra sin pantalla de ingreso
# DEMO_MODE=true

# Lista cerrada de cuentas autorizadas, separadas por coma. Obligatoria fuera de la demo.
# CONSULTORIO_EMAIL=marie@consultorio.com,yani@consultorio.com

# Producción: obligatorio, mínimo 32 caracteres aleatorios (no uses la contraseña)
# openssl rand -hex 32
SESSION_SECRET=

# PostgreSQL (Render Internal Database URL)
# DATABASE_URL=postgresql://...

# Token extra para GET /api/db/all (dump). No lo pongas en el frontend.
# ADMIN_API_TOKEN=

# Supabase Auth y base de datos. Usar la URL del proyecto y la clave publishable/anon.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: asistente IA
GEMINI_API_KEY=

# Zona horaria del consultorio, para saber si un turno ya pasó (links de confirmación).
# APP_TIMEZONE=America/Argentina/Buenos_Aires
