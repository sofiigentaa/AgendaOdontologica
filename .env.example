# Copiá a .env.local (nunca subas secretos a GitHub)

# Local: si no está, el login de desarrollo usa admin123
# Producción (Render): obligatorio, mínimo 12 caracteres
CONSULTORIO_PASSWORD=aaaaaa444555789

# Solo en la copia de demostración: entra sin pantalla de ingreso
# DEMO_MODE=true

# Emails que pueden entrar, separados por coma. Vacío = cualquier email (solo si ya sabe la clave)
# CONSULTORIO_EMAIL=marie@consultorio.com,yani@consultorio.com

# Producción: obligatorio, mínimo 32 caracteres aleatorios (no uses la contraseña)
# openssl rand -hex 32
SESSION_SECRET=

# PostgreSQL (Render Internal Database URL)
# DATABASE_URL=postgresql://...

# Token extra para GET /api/db/all (dump). No lo pongas en el frontend.
# ADMIN_API_TOKEN=

# Opcional: recuperar contraseña por email con Brevo (Render gratis bloquea SMTP)
# BREVO_API_KEY=
# MAIL_FROM=tu-email-verificado-en-brevo@gmail.com
# APP_URL=https://tu-agenda.onrender.com   (en Render se toma sola de RENDER_EXTERNAL_URL)

# Opcional: asistente IA
GEMINI_API_KEY=

# Supabase opcional (solo desde variables de entorno, nunca hardcodeado)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
