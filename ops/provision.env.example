# Copiá este archivo a .provision.env en la raíz del repo.
# .provision.env no se sube a GitHub.

# https://dashboard.render.com/settings#api-keys  (scope de escritura)
RENDER_API_KEY=

# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Email con el que vas a entrar a cada sistema.
PROVISION_EMAIL=

# Si tenés más de una organización en Supabase, el slug (si no, se usa la única).
# SUPABASE_ORG_SLUG=

# Si tenés más de un workspace en Render, el id tea-... o usr-...
# RENDER_OWNER_ID=
